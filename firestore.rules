rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Yönetici: Google ile giriş yapan, e-postası doğrulanmış tek hesap.
    // 'BURAYA_GMAIL_ADRESINIZ' yerine kendi Gmail adresinizi KÜÇÜK HARFLE yazın.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'BURAYA_GMAIL_ADRESINIZ';
    }

    // Yönetici doğrulaması: yönetici sayfası girişte bu belgeyi okumayı dener; yalnızca yönetici okuyabilir.
    match /admin_check/{id} {
      allow read: if isAdmin();
    }

    // Oyuncular: herkes okuyabilir; ekleme/silme/düzenleme yalnızca yönetici.
    // Oylayanlar yalnızca 'peerAttributeVotes' listesine TEK yeni oy ekleyebilir.
    match /players/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['peerAttributeVotes'])
        && request.resource.data.peerAttributeVotes is list
        && request.resource.data.peerAttributeVotes.size() ==
           (('peerAttributeVotes' in resource.data) ? resource.data.peerAttributeVotes.size() : 0) + 1
      );
    }

    // Maçlar: herkes okur, yalnızca yönetici yazar
    match /matches/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Maç puanları: oylayanlar yalnızca yeni kayıt oluşturabilir
    match /match_ratings/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['matchId', 'voterId', 'scores', 'ts']);
      allow update, delete: if isAdmin();
    }

    // Haftalık oy kilidi: yalnızca oluşturulabilir
    match /eval_log/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['voterId', 'period', 'ts']);
      allow update, delete: if isAdmin();
    }

    // Ayarlar (rating oylaması turu açık/kapalı): herkes okur, yalnızca yönetici yazar
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
